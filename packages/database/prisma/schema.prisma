// Olink Desk — domain model v1
//
// Invariants (PROJECT_GUIDELINES.md):
// - Every tenant-data model carries organizationId with an index; every query filters by it.
// - AuditLog.entityId is TEXT — always pass String(uuid), never a raw UUID object.
// - Migrations are append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & people ----------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum PlanTier {
  FREE
  TEAM
  BUSINESS
  ENTERPRISE
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  // Customer-facing languages this tenant serves (subset of en/am/om/ti/so)
  languages       String[] @default(["en", "am"])
  defaultLanguage String   @default("en")
  timezone        String   @default("Africa/Addis_Ababa")

  // Subscription lifecycle — ported pattern from Olink Dispatch.
  // Enforcement is opt-in so nothing locks out until billing is live.
  subscriptionTier      PlanTier              @default(FREE)
  subscriptionStatus    SubscriptionStatus    @default(TRIAL)
  subscriptionInterval  SubscriptionInterval?
  subscriptionPeriodEnd DateTime?
  subscriptionEnforced  Boolean               @default(false)

  // When an admin dismissed the setup checklist. Nullable rather than a
  // boolean so the record says WHEN, which is what makes it auditable; the
  // checklist itself derives every step from real data, and this is the only
  // piece of it that is a stated preference rather than an observation.
  onboardingDismissedAt DateTime?

  // ---- Data lifecycle ----
  //
  // Two windows, not one, because they are different obligations pulling in
  // opposite directions. Ticket content is personal data a tenant must stop
  // holding; the audit log is the record that it stopped, which a regulator
  // or an auditor asks for AFTER the content is gone. Collapsing them into
  // one window means either keeping the words too long or destroying the
  // proof of their destruction.
  //
  // NULL means keep forever, and it is the default: a retention window is a
  // deliberate act by an administrator who knows their own regulator, never
  // something a deploy quietly starts doing to a tenant's history.
  ticketRetentionDays Int?
  auditRetentionDays  Int?

  /// Whether the desk may answer a customer's question itself, with no agent
  /// in the loop.
  ///
  /// Default FALSE and it stays false until an administrator turns it on,
  /// for the same reason retention windows do: this changes what a customer
  /// receives in the organisation's name, and nothing about a deploy should
  /// start doing that on a tenant's behalf. A desk that has written no
  /// knowledge articles yet would answer nothing anyway — but the decision
  /// is theirs to make explicitly rather than to discover.
  autoAnswerEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  contacts         Contact[]
  tickets          Ticket[]
  ticketMessages   TicketMessage[]
  callLogs         CallLog[]
  tasks            Task[]
  queues           Queue[]
  slaPolicies      SlaPolicy[]
  dispositionCodes DispositionCode[]
  auditLogs        AuditLog[]
  channelAccounts  ChannelAccount[]
  conversations    Conversation[]
  macros           Macro[]
  notifications    Notification[]
  tags             Tag[]
  ticketTags       TicketTag[]
  kbArticles       KbArticle[]
  attachments      Attachment[]
}

enum UserRole {
  AGENT
  SUPERVISOR
  ADMIN
  AUDITOR // read-only
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String
  phone        String?
  name         String
  role         UserRole   @default(AGENT)
  status       UserStatus @default(INVITED)
  locale       String     @default("en")
  passwordHash String?

  // Progressive lockout — ported pattern from Onekof.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTickets     Ticket[]        @relation("TicketAssignee")
  messages            TicketMessage[]
  callLogs            CallLog[]
  assignedTasks       Task[]          @relation("TaskAssignee")
  createdTasks        Task[]          @relation("TaskCreator")
  createdMacros       Macro[]         @relation("MacroCreator")
  kbArticles          KbArticle[]     @relation("KbAuthor")
  notifications       Notification[]
  uploadedAttachments Attachment[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// Phone-number-first identity: phone is the primary key of Ethiopian
// customer identity. Email and Telegram are optional attachments.
model Contact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Identity is "at least one of phone or email", not "phone". The rule was
  // written when every channel was phone-first; an email customer has no
  // phone, and their address is an equally durable identity — it is the only
  // one they have. Each is unique WHEN PRESENT: Postgres allows many NULLs in
  // a unique index, which is exactly the semantics wanted here.
  phone      String?
  name       String?
  email      String?
  telegramId String?
  language   String  @default("am")
  smsConsent Boolean @default(true)
  notes      String?

  /// Set when this person's identifying details were erased on request. The
  /// ROW survives the erasure deliberately: a ticket has to keep pointing at
  /// somebody, and last quarter's volume, SLA attainment and satisfaction
  /// figures must not silently change because a customer exercised a right.
  /// What is erased is everything that identifies them — name, phone, email,
  /// Telegram id, notes — after which the row is a bare counter and no longer
  /// personal data.
  erasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets       Ticket[]
  messages      TicketMessage[]
  callLogs      CallLog[]
  conversations Conversation[]
  attachments   Attachment[]

  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@index([organizationId, telegramId])
}

// ---------- Channel conversations ----------

// One row per (organization, channel, external user) — the channel-side
// identity a webhook can actually see, ported from Bank Assist's Conversation.
// A Telegram chat id or a widget session id is not a Contact: the person's
// phone (Desk's primary identity) is unknown until they share it. Contact
// linkage is optional and attached later, exactly like Bank Assist's contact
// capture. Tickets thread through this row: an inbound message reuses the
// conversation's newest open ticket, else opens a new one (ADR 0002).
model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  channel        Channel
  externalUserId String

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // Sticky conversation language: set from detection, kept until a later
  // message carries a clear different signal (Bank Assist finding #5).
  language String @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@unique([organizationId, channel, externalUserId])
  @@index([organizationId, contactId])
}

// ---------- Tickets & the unified timeline ----------

enum Channel {
  TELEGRAM
  PHONE
  SMS
  USSD
  WEB
  EMAIL
  WHATSAPP
  MESSENGER
  INSTAGRAM
  VIBER
  WALK_IN
}

enum TicketStatus {
  NEW
  OPEN
  PENDING // waiting on customer
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Human-facing per-org ticket number, assigned by application logic
  // (per-org sequence), unique within the tenant.
  number Int

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  channel  Channel
  subject  String?
  category String?
  language String         @default("am")
  status   TicketStatus   @default(NEW)
  priority TicketPriority @default(NORMAL)

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])
  queueId    String?
  queue      Queue?  @relation(fields: [queueId], references: [id])

  // SLA timers — due dates computed from SlaPolicy business hours at creation.
  slaPolicyId        String?
  slaPolicy          SlaPolicy? @relation(fields: [slaPolicyId], references: [id])
  firstResponseDueAt DateTime?
  resolveDueAt       DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?

  // CSAT — surveyed on the channel the ticket arrived on, in the customer's
  // own language. `csatSentAt` is what makes the survey answerable: an
  // inbound number is only read as a score while a survey is open on this
  // ticket, so "5" is a rating today and an ordinary message next month.
  csatScore   Int?
  csatComment String?
  csatSentAt  DateTime?

  // Duplicate handling: a merged ticket points at its survivor.
  mergedIntoId String?
  mergedInto   Ticket?  @relation("TicketMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Ticket[] @relation("TicketMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      TicketMessage[]
  callLogs      CallLog[]
  tasks         Task[]
  notifications Notification[]
  tags          TicketTag[]
  attachments   Attachment[]

  @@unique([organizationId, number])
  @@index([organizationId, conversationId])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
  // The retention pass asks one question — "which of this tenant's tickets
  // closed before the cutoff" — and without this it asks it with a sequential
  // scan over every ticket the tenant has ever had, nightly, forever.
  @@index([organizationId, closedAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  NOTE // internal, never customer-visible
}

model TicketMessage {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  direction MessageDirection
  channel   Channel
  body      String

  /// Set on an OUTBOUND row the desk sent by itself, with no agent involved.
  ///
  /// This is the only way deflection can be counted. Without it "how many
  /// tickets did we answer without a person" is unanswerable, and a
  /// deflection rate that cannot be computed is a claim rather than a
  /// number — which is exactly what this feature must not be.
  autoAnswered Boolean @default(false)

  /// Set on an OUTBOUND row the AGENT delivered themselves — a callback on a
  /// logged phone ticket, a word at the counter on a walk-in — rather than
  /// one the desk carried.
  ///
  /// A ticket with no conversation has no transport, so `sendAgentReply`
  /// refuses it. Without this flag that refusal was terminal: the ticket
  /// could never record a first response, so it stayed "awaiting first
  /// reply" forever, breached its SLA, kept raising escalations, and left
  /// every phone call the team actually made invisible in the reports. The
  /// desk cannot observe a callback, so the agent asserting it is the only
  /// honest signal available — and it is marked as an assertion rather than
  /// silently mixed in with messages the desk itself delivered.
  offChannel Boolean @default(false)

  /// Set when the body was emptied by a retention pass or an erasure. The row
  /// stays so the shape of the conversation stays true — who spoke, on which
  /// channel, in which direction, and when. A deleted row would quietly
  /// rewrite the first-response time that was computed from it.
  ///
  /// The tombstone a reader sees is rendered from the i18n table, not stored:
  /// the database must not hold one language's sentence for a product that
  /// serves six.
  redactedAt DateTime?

  authorUserId String?
  authorUser   User?    @relation(fields: [authorUserId], references: [id])
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id])

  // Channel-side id (Telegram message id, SMS provider id, email Message-ID)
  // for dedup and threading.
  externalId String?

  createdAt   DateTime     @default(now())
  attachments Attachment[]

  @@index([organizationId, ticketId, createdAt])
  @@index([organizationId, externalId])
}

// ---------- Call tracking (logging, never carriage) ----------

enum CallDirection {
  INBOUND
  OUTBOUND
  MISSED
}

model CallLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  direction   CallDirection
  phoneNumber String
  startedAt   DateTime      @default(now())
  durationSec Int?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  agentId   String?
  agent     User?    @relation(fields: [agentId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])

  dispositionCodeId String?
  dispositionCode   DispositionCode? @relation(fields: [dispositionCodeId], references: [id])
  outcomeNotes      String?

  followUpTaskId String? @unique
  followUpTask   Task?   @relation(fields: [followUpTaskId], references: [id])

  // Reference row from an imported CDR (Ethio Telecom CCaaS / PBX export),
  // for after-the-fact call ↔ ticket matching.
  cdrRef String?

  createdAt DateTime @default(now())

  @@index([organizationId, startedAt])
  @@index([organizationId, phoneNumber])
  @@index([organizationId, ticketId])
}

model DispositionCode {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  code   String
  label  String
  active Boolean @default(true)

  callLogs CallLog[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ---------- Tasks ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  title       String
  description String?
  status      TaskStatus     @default(TODO)
  priority    TicketPriority @default(NORMAL)
  dueAt       DateTime?

  assigneeId  String?
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User    @relation("TaskCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callLog CallLog?

  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([organizationId, ticketId])
}

// ---------- Routing & SLA ----------

model Queue {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String

  tickets Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model SlaPolicy {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name                 String
  firstResponseMinutes Int
  resolveMinutes       Int
  // Business-hours definition: work week + hours + Ethiopian public holidays.
  // Structured JSON so tenants configure without schema changes.
  businessHours        Json
  escalation           Json?
  isDefault            Boolean @default(false)

  tickets Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ---------- Channel accounts (per-tenant credentials) ----------

enum ChannelAccountKind {
  TELEGRAM_BOT
  VIBER_BOT
  META_WHATSAPP
  META_MESSENGER
  META_INSTAGRAM
  SMS_AFROMESSAGE
  SMS_GEEZSMS
  SMS_FALCONVAS
  USSD_GATEWAY
  EMAIL_INBOUND
}

model ChannelAccount {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  kind   ChannelAccountKind
  label  String
  // Provider credentials/config (bot token, sender id, API key reference).
  // Encrypted at the application layer before storage.
  config Json
  active Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, kind])
}

// ---------- Macros (canned replies) ----------

// A saved reply an agent applies with one click. `bodies` is a JSON map of
// language code to text ({"en": "...", "am": "..."}) rather than one column
// per language or one row per translation, because a macro is edited as a
// single object and a language added to the fleet must not need a migration.
//
// The rule that makes this worth building: a macro renders in the CUSTOMER's
// language, not the agent's (see packages/macros/src/render.ts). The bodies
// map is what makes that possible.
model Macro {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  title    String
  category String?
  bodies   Json

  // Applied to the ticket after the reply is actually delivered — never at
  // insert time. A macro that changed the status while the agent was still
  // reading the draft would move a ticket nobody had answered.
  //
  // CLOSED and NEW are refused at the edge (`cleanActions`), not by the type:
  // a macro fired in one click must not end a conversation the customer is
  // still in, nor walk a ticket back past its own first-response clock.
  setStatus   TicketStatus?
  setPriority TicketPriority?
  addTags     String[]        @default([])

  isActive   Boolean @default(true)
  usageCount Int     @default(0)

  createdById String?
  createdBy   User?   @relation("MacroCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, title])
  @@index([organizationId, isActive])
}

// ---------- Knowledge base ----------

// An answer the desk has already written down, so a customer can get it
// without waiting for a person.
//
// `bodies` is a language map like a Macro's (ADR 0007), for the same reason:
// one article is edited as a single thing, and a customer must be answered in
// their own language or not at all. Retrieval never crosses languages — an
// English article shown to a Tigrinya customer is the failure this product
// exists to avoid.
model KbArticle {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Titles per language too: the title is what a customer is offered when
  // retrieval is unsure, so it cannot be English-only.
  titles Json
  bodies Json

  isPublished Boolean @default(false)
  // How often this article was shown INSTEAD of opening a ticket. The one
  // number that says whether writing it was worth the afternoon.
  deflections Int     @default(0)
  views       Int     @default(0)

  createdById String?
  createdBy   User?   @relation("KbAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isPublished])
}

// ---------- Tags ----------

// What a ticket is ABOUT, as opposed to where it came from (channel) or who
// handles it (queue). Free-form enough that an agent can label a new kind of
// problem the moment it appears, controlled enough that the labels are worth
// counting later.
//
// `slug` is the normalised form and carries the uniqueness; `name` is what a
// person typed. Without that split a desk ends up with "Refund", "refund"
// and "refund " as three separate tags, and any report built on them is
// quietly wrong — which is the whole reason tags exist here.
model Tag {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String
  slug String

  createdAt DateTime @default(now())

  tickets TicketTag[]

  @@unique([organizationId, slug])
  @@index([organizationId, name])
}

// The join. Explicit rather than an implicit m-n relation so it carries its
// own organizationId — every tenant-data model does, and the schema guard
// test enforces it.
model TicketTag {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ticketId, tagId])
  @@index([organizationId, tagId])
}

// ---------- Notifications ----------

enum NotificationKind {
  SLA_AT_RISK
  SLA_BREACHED
  UNASSIGNED_WAITING
}

// Something a person needs to be told about, recorded rather than pushed.
//
// The SLA engine computed breach from the beginning, but only inside the
// wallboard route — so the only thing that knew a promise had been missed
// was a screen somebody had to be watching. A row here is what turns that
// derivation into an alarm.
//
// `userId` is nullable: a ticket nobody owns is the workspace's problem, and
// addressing it to an individual would hide it from everyone else.
/// A file a customer sent or an agent attached — a screenshot of an error, a
/// receipt, a signed form, or a voice note recorded at the desk.
///
/// **The bytes live in Postgres.** That is a deliberate choice for this stage,
/// not an oversight: object storage means a bucket, a service-account grant
/// and a signed-URL path, which is real infrastructure to provision before
/// anybody can attach a screenshot. A support desk's attachments are small and
/// few — screenshots, PDFs, a minute of voice — so a capped `Bytes` column
/// ships the feature today with nothing to configure.
///
/// The cost is honest and bounded: database size and backup weight grow with
/// attachments, and `MAX_ATTACHMENT_BYTES` is what keeps that predictable.
/// When a desk outgrows it, `data` becomes a storage key and only
/// `attachments.ts` changes — every caller already goes through it.
model Attachment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// The message this arrived with, when it arrived with one. Null for a file
  /// attached to the ticket itself rather than to a particular reply.
  messageId String?
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  /// As the customer or agent named it, sanitised. Never used as a path.
  filename    String
  /// Sniffed from the bytes, not trusted from the client — see attachments.ts.
  contentType String
  byteSize    Int

  /// A voice note is played rather than downloaded, and is recorded at the
  /// desk rather than chosen from a disk. Same row, different affordance.
  kind            AttachmentKind @default(FILE)
  /// Length in seconds, for a voice note only. Null for a file.
  durationSeconds Int?

  data Bytes

  /// Set when the bytes were emptied by a retention pass or an erasure.
  /// `byteSize` is deliberately left at its historical value — it is not
  /// personal data, and it is what keeps a storage report honest about what
  /// this desk once held.
  redactedAt DateTime?

  uploadedByUserId String?
  uploadedByUser   User?    @relation(fields: [uploadedByUserId], references: [id])
  /// Set when the file came FROM the customer rather than from an agent.
  contactId        String?
  contact          Contact? @relation(fields: [contactId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, ticketId, createdAt])
}

enum AttachmentKind {
  FILE
  VOICE
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  kind   NotificationKind
  userId String?
  user   User?            @relation(fields: [userId], references: [id])

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // One notification per (ticket, kind), ever. A cron running every few
  // minutes must not re-tell a supervisor the same thing twelve times an
  // hour; the constraint is what makes the escalation pass idempotent
  // without the pass having to remember anything.
  @@unique([ticketId, kind])
  @@index([organizationId, readAt])
  @@index([organizationId, createdAt])
}

// ---------- Audit ----------

model AuditLog {
  id             BigInt       @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  actorUserId String?
  action      String
  entityType  String
  // TEXT by fleet convention — always pass String(uuid), never a raw UUID.
  entityId    String
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}
