# Olink Desk — environment template. Copy to .env and fill in.
# NEVER commit .env. Production secrets live in the deployment platform's secret store.

# --- Core ---
DATABASE_URL="postgresql://user:password@localhost:5432/olink_desk"
JWT_SECRET="change-me-64-random-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Deployment tier (fleet convention: 1=EthioTelecom ECS, 2=on-prem Ethiopia, 3=EU cloud) ---
# Local dev deliberately reports tier 3 (least privileged) so residency gates
# cannot pass on a laptop and fail in production.
DEPLOYMENT_TIER="3"

# --- Channels ---
# Public base URL of this deployment — webhook URLs are built from it.
APP_BASE_URL="http://localhost:3000"
# AES-256 key (base64, exactly 32 bytes) sealing per-tenant channel
# credentials (bot tokens, webhook secrets) in ChannelAccount.config.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Fails closed: unset means channel credentials can be neither stored nor read.
CHANNEL_CONFIG_KEY=""
# Interim operator guard on channel-admin routes until the auth port lands.
# Constant-time compared, fails closed (routes 503 when unset).
DESK_ADMIN_SECRET=""
# Per-tenant Telegram bot tokens and webhook secrets live in the DB
# (ChannelAccount, sealed) — there is no global Telegram env var.

# --- SMS aggregators (fill the one(s) in use; adapters select by config) ---
AFROMESSAGE_API_KEY=""
GEEZSMS_API_KEY=""
FALCONVAS_API_KEY=""

# --- Billing (push-payment rails — there is no card-on-file in Ethiopia) ---
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""
TELEBIRR_APP_ID=""
TELEBIRR_APP_KEY=""

# --- Cron (compare with constant-time HMAC; fail closed when unset) ---
CRON_SECRET=""
