{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "CHANNEL_CONFIG_KEY", "JWT_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
